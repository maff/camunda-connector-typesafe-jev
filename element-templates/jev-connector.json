{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Jev (TypeSafe)",
  "id": "io.camunda:jev:1",
  "description": "Use TypeSafe's Jev model to classify, score, or judge any piece of text or structured data, and get back reliable, structured answers your process can act on directly.",
  "metadata": {
    "keywords": [ "typesafe", "jev", "ai", "judgment", "classification" ]
  },
  "documentationRef": "https://docs.typesafe.ai/",
  "icon": {
    "contents": "data:image/png;base64,"
  },
  "version": 1,
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [ "bpmn:Task" ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "engines": {
    "camunda": "^8.8"
  },
  "groups": [
    { "id": "authentication", "label": "Authentication" },
    { "id": "payload", "label": "Payload", "openByDefault": true },
    { "id": "output", "label": "Output mapping" },
    { "id": "error", "label": "Error handling" },
    { "id": "retries", "label": "Retries" }
  ],
  "properties": [
    {
      "value": "io.camunda:http-json:1",
      "binding": {
        "property": "type",
        "type": "zeebe:taskDefinition"
      },
      "type": "Hidden"
    },
    {
      "value": "bearer",
      "binding": {
        "name": "authentication.type",
        "type": "zeebe:input"
      },
      "type": "Hidden"
    },
    {
      "id": "authentication.token",
      "label": "API key",
      "group": "authentication",
      "feel": "optional",
      "constraints": {
        "notEmpty": true
      },
      "binding": {
        "name": "authentication.token",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "value": "POST",
      "binding": {
        "name": "method",
        "type": "zeebe:input"
      },
      "type": "Hidden"
    },
    {
      "value": "https://api.typesafe.ai/v1/systemone",
      "binding": {
        "name": "url",
        "type": "zeebe:input"
      },
      "type": "Hidden"
    },
    {
      "value": "={\"Content-Type\": \"application/json\"}",
      "binding": {
        "name": "headers",
        "type": "zeebe:input"
      },
      "type": "Hidden"
    },
    {
      "id": "model",
      "label": "Model",
      "group": "payload",
      "feel": "optional",
      "value": "jev-latest",
      "constraints": {
        "notEmpty": true
      },
      "binding": {
        "name": "internal_model",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "id": "state",
      "label": "State",
      "tooltip": "The facts Jev reads before answering your questions, like the message, ticket, or record you want it to judge. See <a href=\"https://docs.typesafe.ai/concepts/state\">State</a>. Can be a plain string, or an object/list if you need to give it several related pieces of context.",
      "group": "payload",
      "feel": "optional",
      "constraints": {
        "notEmpty": true
      },
      "binding": {
        "name": "internal_state",
        "type": "zeebe:input"
      },
      "type": "Text"
    },
    {
      "id": "questions",
      "label": "Questions",
      "tooltip": "The judgments to make about the state above, one per question. See <a href=\"https://docs.typesafe.ai/primitives\">primitives</a> for what a question can ask (Noul, Choice, Score), and the <a href=\"https://docs.typesafe.ai/api#param-questions\">API reference</a> for the exact JSON shape this field must match.",
      "group": "payload",
      "feel": "required",
      "value": "={\n  \"is_urgent\": {\n    \"type\": \"noul\",\n    \"instructions\": \"Does this convey urgency?\"\n  }\n}",
      "constraints": {
        "notEmpty": true
      },
      "binding": {
        "name": "internal_questions",
        "type": "zeebe:input"
      },
      "type": "Text"
    },
    {
      "value": "={\"state\": internal_state, \"model\": internal_model, \"questions\": internal_questions}",
      "binding": {
        "name": "body",
        "type": "zeebe:input"
      },
      "type": "Hidden"
    },
    {
      "value": "1",
      "binding": {
        "key": "elementTemplateVersion",
        "type": "zeebe:taskHeader"
      },
      "type": "Hidden"
    },
    {
      "value": "io.camunda:jev:1",
      "binding": {
        "key": "elementTemplateId",
        "type": "zeebe:taskHeader"
      },
      "type": "Hidden"
    },
    {
      "id": "resultVariable",
      "label": "Result variable",
      "tooltip": "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation</a>.",
      "group": "output",
      "binding": {
        "key": "resultVariable",
        "type": "zeebe:taskHeader"
      },
      "type": "String"
    },
    {
      "id": "resultExpression",
      "label": "Result expression",
      "tooltip": "Expression to map the response into process variables. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-expression\" target=\"_blank\">documentation</a>.",
      "value": "{\n  jevResult: response.body\n}",
      "feel": "required",
      "group": "output",
      "binding": {
        "key": "resultExpression",
        "type": "zeebe:taskHeader"
      },
      "type": "Text"
    },
    {
      "id": "errorExpression",
      "label": "Error expression",
      "tooltip": "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/\" target=\"_blank\">documentation</a>.",
      "feel": "required",
      "group": "error",
      "binding": {
        "key": "errorExpression",
        "type": "zeebe:taskHeader"
      },
      "type": "Text"
    },
    {
      "id": "retryCount",
      "label": "Retries",
      "tooltip": "Number of retries",
      "value": "3",
      "feel": "optional",
      "group": "retries",
      "binding": {
        "property": "retries",
        "type": "zeebe:taskDefinition"
      },
      "type": "String"
    },
    {
      "id": "retryBackoff",
      "label": "Retry backoff",
      "tooltip": "ISO-8601 duration to wait between retries",
      "value": "PT30S",
      "group": "retries",
      "binding": {
        "key": "retryBackoff",
        "type": "zeebe:taskHeader"
      },
      "type": "String"
    },
    {
      "id": "jobTimeout",
      "label": "Job timeout",
      "tooltip": "ISO-8601 duration after which Zeebe considers this job timed out if not yet completed. Leave empty to use the default timeout",
      "optional": true,
      "group": "retries",
      "binding": {
        "key": "jobTimeout",
        "type": "zeebe:taskHeader"
      },
      "type": "String"
    }
  ]
}
